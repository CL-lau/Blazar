{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blazar",
  "version": "0.1.0",
  "identifier": "com.blazar.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop",
    "beforeBuildCommand": "npm run desktop:build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Blazar", "width": 1040, "height": 740 }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": { "active": true, "targets": ["app", "dmg"], "icon": ["icons/icon.png", "icons/icon.icns"] }
}
